{
  "type": "object",
  "title": "DALI → Home Assistant",
  "description": "Выберите устройства DALI и контролы, которые нужно передать в Home Assistant. Список обновляется автоматически из MQTT при открытии страницы.",
  "configFile": {
    "path": "/etc/wb-dali-ha.json",
    "service": "wb-dali-ha",
    "fromJSON": ["/usr/lib/wb-dali-ha/wb_dali_ha_config.py", "--from-json"],
    "toJSON": ["/usr/lib/wb-dali-ha/wb_dali_ha_config.py", "--to-json"],
    "restartDelayMS": 1000,
    "validate": true,
    "needReload": true
  },
  "properties": {
    "mqtt": {
      "type": "object",
      "title": "Подключение MQTT",
      "propertyOrder": 1,
      "properties": {
        "host": { "type": "string", "title": "MQTT-сервер", "default": "127.0.0.1" },
        "port": { "type": "integer", "title": "Порт", "default": 1883, "minimum": 1, "maximum": 65535 },
        "username": { "type": "string", "title": "Пользователь", "default": "" },
        "password": { "type": "string", "title": "Пароль", "format": "password", "default": "" },
        "discovery_prefix": { "type": "string", "title": "Префикс Discovery", "default": "homeassistant" }
      }
    },
    "devices": {
      "type": "array",
      "title": "Устройства DALI",
      "propertyOrder": 2,
      "items": {
        "type": "object",
        "title": "Устройство DALI",
        "properties": {
          "id": { "type": "string", "title": "Идентификатор устройства", "readOnly": true, "propertyOrder": 1 },
          "name": { "type": "string", "title": "Название в Home Assistant", "propertyOrder": 2 },
          "light": { "type": "boolean", "title": "Создать светильник", "_format": "checkbox", "default": true, "propertyOrder": 3 },
          "controls": {
            "type": "object",
            "title": "Контролы для передачи в Home Assistant",
            "description": "Яркость, текущий уровень, включение и выключение объединяются в один источник света. Отдельные сущности создаются только для дополнительных контролов.",
            "propertyOrder": 4,
            "properties": {
              "wanted_level": { "type": "boolean", "title": "Яркость (wanted_level)", "_format": "checkbox" },
              "actual_level": { "type": "boolean", "title": "Текущая яркость (actual_level)", "_format": "checkbox" },
              "on_and_step_up": { "type": "boolean", "title": "Включение (on_and_step_up)", "_format": "checkbox" },
              "off": { "type": "boolean", "title": "Выключение (off)", "_format": "checkbox" },
              "step_up": { "type": "boolean", "title": "Увеличить яркость (step_up)", "_format": "checkbox" },
              "step_down": { "type": "boolean", "title": "Уменьшить яркость (step_down)", "_format": "checkbox" },
              "go_to_scene": { "type": "boolean", "title": "Сцена (go_to_scene)", "_format": "checkbox" },
              "error_status": { "type": "boolean", "title": "Ошибка DALI (error_status)", "_format": "checkbox" }
            }
          }
        }
      }
    }
  }
}
